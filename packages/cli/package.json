{
  "name": "@tego/cli",
  "version": "2.0.0-alpha.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/src/index.d.ts",
  "bin": {
    "tego": "./dist/src/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test:unit": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@tego/contracts": "2.0.0-alpha.1",
    "@tego/drivers-local": "2.0.0-alpha.1",
    "@tego/drivers-postgres": "2.0.0-alpha.1",
    "@tego/executor-node": "2.0.0-alpha.1",
    "@tego/plugin-sdk": "2.0.0-alpha.1",
    "@tego/runtime": "2.0.0-alpha.1",
    "@tego/transport-websocket": "2.0.0-alpha.1",
    "typescript": "7.0.2"
  }
}
