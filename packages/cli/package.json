{
  "name": "@tegojs/cli",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/src/index.d.ts",
  "bin": {
    "tego": "./dist/src/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test:unit": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@tegojs/contracts": "0.0.0",
    "@tegojs/drivers-local": "0.0.0",
    "@tegojs/drivers-postgres": "0.0.0",
    "@tegojs/executor-node": "0.0.0",
    "@tegojs/plugin-sdk": "0.0.0",
    "@tegojs/runtime": "0.0.0",
    "@tegojs/transport-websocket": "0.0.0",
    "typescript": "7.0.2"
  }
}
