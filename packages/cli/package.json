{
  "name": "@tego/cli",
  "version": "2.0.0-alpha.1",
  "type": "module",
  "description": "Command-line interface for experimental Tego runtime deployments.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/tegojs/tego-next#readme",
  "bugs": {
    "url": "https://github.com/tegojs/tego-next/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tegojs/tego-next.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.js.map",
    "dist/src/**/*.d.ts",
    "dist/src/**/*.d.ts.map",
    "dist/src/**/*.ps1",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/src/index.d.ts",
  "bin": {
    "tego": "./dist/src/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/copy-windows-pipe-security.mjs",
    "test:unit": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@tego/contracts": "2.0.0-alpha.1",
    "@tego/drivers-local": "2.0.0-alpha.1",
    "@tego/drivers-postgres": "2.0.0-alpha.1",
    "@tego/executor-node": "2.0.0-alpha.1",
    "@tego/plugin-sdk": "2.0.0-alpha.1",
    "@tego/runtime": "2.0.0-alpha.1",
    "@tego/transport-websocket": "2.0.0-alpha.1",
    "typescript": "7.0.2"
  }
}
