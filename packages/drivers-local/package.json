{
  "name": "@tego/drivers-local",
  "version": "2.0.0-alpha.1",
  "type": "module",
  "description": "Local development drivers for the experimental Tego runtime.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/tegojs/tego-next#readme",
  "bugs": {
    "url": "https://github.com/tegojs/tego-next/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tegojs/tego-next.git",
    "directory": "packages/drivers-local"
  },
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.js.map",
    "dist/src/**/*.d.ts",
    "dist/src/**/*.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@tego/contracts": "2.0.0-alpha.1"
  },
  "devDependencies": {
    "@tego/testkit": "2.0.0-alpha.1"
  }
}
